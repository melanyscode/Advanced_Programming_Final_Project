@{
    ViewBag.Title = "Home Page";
}
@model FinalProject.Mvc.Models.DashboardView

<main>

    <div class="usrcard-card">
        <div class="usrcard-icon">
            @( (ViewBag.Username != null && ViewBag.Username.Length > 0)
            ? ViewBag.Username.Substring(0, 1).ToUpper()
            : "?" )
        </div>
        <div class="usrcard-details">
            <h4>@(ViewBag.Username ?? "Invitado")</h4>
            <p><span>Role:</span> @(ViewBag.Role ?? "Sin Rol")</p>
        </div>
    </div>

    <section class="row" aria-labelledby="aspnetTitle">

        <form method="post" action="@Url.Action("AddTask")" class="form-switch-section">
            <div class="form-switch-buttons">
                <select name="taskId" class="form-switch-btn" required>
                    <option value="">Tasks</option>
                    @foreach (var task in Model.AllTasks)
                    {
                        <option value="@task.TaskId">@task.TaskName</option>
                    }
                </select>
                <select name="chart" class="form-switch-btn" required>
                    <option value="1">Chart Type</option>
                    <option value="1">Donut Chart</option>
                    <option value="2">Line Chart</option>
                    <option value="3">Bar Chart</option>
                </select>
                <select name="interval" class="form-switch-btn" required>
                    <option value="24">Interval</option>
                    <option value="1">Every hour</option>
                    <option value="2">Every 2 hours</option>
                    <option value="3">Every three hours</option>
                    <option value="5">Every 5 hours</option>
                    <option value="8">Every 8 hours</option>
                    <option value="24">Every 24 Hours</option>
                </select>
                <button type="submit" class="form-switch-btn active">Add</button>
            </div>
        </form>


        <div id="task-cards-container" style="display:flex; flex-wrap: wrap; gap: 20px;">

        </div>

    </section>


    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        async function fetchUserTasks() {
            try {
                const response = await fetch('@Url.Action("GetUserTasks")');
                const tasks = await response.json();

                const container = document.getElementById('task-cards-container');
                container.innerHTML = '';

               tasks.forEach(task => {
                    let val = parseInt(task.Result?.replace("%", "").trim()) || 0;
                    val = Math.min(100, Math.max(0, val));

                    const taskCard = document.createElement('div');
                   taskCard.className = 'dash-card';

                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = '@Url.Action("RemoveTask")';
                    form.className = 'remove-task-form';


                    taskCard.appendChild(form);

                   if (task.ChartType === 1) {
                        const form = document.createElement('form');
                        form.method = 'post';
                        form.action = '@Url.Action("RemoveTask")';
                        form.className = 'remove-task-form';

                        const hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'taskId';
                        hiddenInput.value = task.TaskId;
                        form.appendChild(hiddenInput);

                        const btn = document.createElement('button');
                        btn.type = 'submit';
                        btn.setAttribute('aria-label', 'Remove task');
                        btn.innerHTML = '&times;';
                        form.appendChild(btn);

                        taskCard.appendChild(form);
                        const graphic = document.createElement('div');
                       graphic.className = "dash-card-add";

                        const progressCircle = document.createElement('div');
                        progressCircle.className = 'progress-circle';
                        progressCircle.style.setProperty('--progress', val);
                        progressCircle.innerHTML = `<span>${val}%</span>`;
                        graphic.appendChild(progressCircle);

                        taskCard.appendChild(graphic);

                   } else if (task.ChartType === 2) {
                        const form = document.createElement('form');
                        form.method = 'post';
                        form.action = '@Url.Action("RemoveTask")';
                        form.className = 'remove-task-form';

                        const hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'taskId';
                        hiddenInput.value = task.TaskId;
                        form.appendChild(hiddenInput);

                        const btn = document.createElement('button');
                        btn.type = 'submit';
                        btn.setAttribute('aria-label', 'Remove task');
                        btn.innerHTML = '&times;';
                        form.appendChild(btn);

                        taskCard.appendChild(form);
                        console.log(task.history);

                        const canvas = document.createElement('canvas');
                        canvas.style.width = "200px";
                        canvas.style.height = "150px";
                        taskCard.appendChild(canvas);

                        const labels = task.History.map(h => {
                            const date = new Date(h.date);
                            console.log( "fecha " + h.date)
                            return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        });

                        console.log(typeof labels)
                        const dataValues = task.History.map(h => h.value);

                       new Chart(canvas.getContext('2d'), {
                           type: 'line',
                           data: {
                               labels: labels,
                               datasets: [{
                                   label: "",
                                   data: dataValues,
                                   borderColor: '#00e5ff',
                                   backgroundColor: 'rgba(0, 199, 199, 0.3)',
                                   fill: true,
                                   tension: 0.3
                               }]
                           },
                           options: {
                               responsive: true,
                               maintainAspectRatio: false,
                               plugins: {
                                   legend: {
                                       display: false
                                   },
                                   tooltip: {
                                       enabled: true,
                                       backgroundColor: 'rgba(0, 199, 199, 0.9)',
                                       titleFont: {
                                           size: 18,
                                           weight: 'bold'
                                       },
                                       bodyFont: {
                                           size: 16
                                       },
                                       padding: 12,
                                       cornerRadius: 8,
                                       displayColors: true,
                                       caretPadding: 10,
                                       boxPadding: 10
                                   }
                               },
                               scales: {
                                   y: {
                                       beginAtZero: true,
                                       max: 100
                                   }
                               }
                           }
                       });


                   } else if (task.ChartType === 3) {
                        const form = document.createElement('form');
                        form.method = 'post';
                        form.action = '@Url.Action("RemoveTask")';
                        form.className = 'remove-task-form';

                        const hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'taskId';
                        hiddenInput.value = task.TaskId;
                        form.appendChild(hiddenInput);

                        const btn = document.createElement('button');
                        btn.type = 'submit';
                        btn.setAttribute('aria-label', 'Remove task');
                        btn.innerHTML = '&times;';
                        form.appendChild(btn);

                        taskCard.appendChild(form);
                        console.log(task.history);

                        const canvas = document.createElement('canvas');
                        canvas.style.width = "200px";
                        canvas.style.height = "150px";
                        taskCard.appendChild(canvas);

                        const labels = task.History.map(h => {
                            const date = new Date(h.date);
                            console.log("fecha " + h.date)
                            return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        });

                        console.log(typeof labels)
                        const dataValues = task.History.map(h => h.value);

                       new Chart(canvas.getContext('2d'), {
                           type: 'bar',
                           data: {
                               labels: labels,
                               datasets: [{
                                   label: "",
                                   data: dataValues,
                                   borderColor: '#00e5ff',
                                   backgroundColor: 'rgba(0, 199, 199, 0.6)',
                                   fill: true,
                                   tension: 0.3
                               }]
                           },
                           options: {
                               responsive: true,
                               maintainAspectRatio: false,
                               plugins: {
                                   legend: {
                                       display: false
                                   },
                                   tooltip: {
                                       enabled: true,
                                       backgroundColor: 'rgba(0, 199, 199, 0.2)',
                                       titleFont: {
                                           size: 18,
                                           weight: 'bold'
                                       },
                                       bodyFont: {
                                           size: 16
                                       },
                                       padding: 12,
                                       cornerRadius: 8,
                                       displayColors: true,
                                       caretPadding: 10,
                                       boxPadding: 10
                                   }
                               },
                               scales: {
                                   y: {
                                       beginAtZero: true,
                                       max: 100
                                   }
                               }
                           }
                       });

                   }

                    const taskNameDiv = document.createElement('div');
                    taskNameDiv.className = 'task-name';
                    taskNameDiv.textContent = task.TaskName;
                    taskCard.appendChild(taskNameDiv);

                    container.appendChild(taskCard);
                });


            } catch (error) {
                console.error('Error fetching tasks:', error);
            }
        }

        setInterval(fetchUserTasks, 5000);


        fetchUserTasks();
    </script>

</main>
