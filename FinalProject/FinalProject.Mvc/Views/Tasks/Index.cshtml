@model IEnumerable<FinalProject.Data.Tasks>

<link href="~/Content/Site.css" rel="stylesheet" />

@{
    ViewBag.Title = "Index";
    var groupedTasks = Model.GroupBy(t => t.Priority);
}

@{
    var role = (Session["RoleId"] ?? "").ToString();
    bool isAdmin = role.Equals("Admin", StringComparison.OrdinalIgnoreCase);
}
<div class="switch-section">
    <div class="switch-buttons">
        <a href="https://localhost:44368/Tasks/Index" class="switch-btn active">Priority</a>
        <a href="https://localhost:44368/UserTasks/Index" class="switch-btn">Status</a>
    </div>
    <hr class="custom-divider" />
</div>

@if (ViewBag.IsAdmin == true)
{
    <p>
        @Html.ActionLink("CREATE NEW", "Create", null, new { @class = "top-link" })
    </p>
}

@foreach (var group in groupedTasks.OrderBy(g => g.Key))
{
    <div style="margin-bottom: 40px;">
        <h3 style="margin-top: 30px;">@group.Key Priority</h3>

        <table class="table" style="margin-top: 15px;">
            <tr>
                <th style="width: 200px;">@Html.DisplayNameFor(model => model.TaskName)</th>
                <th style="width: 150px;">@Html.DisplayNameFor(model => model.Priority)</th>
                <th style="width: 300px;">@Html.DisplayNameFor(model => model.Executable)</th>
                <th style="width: 300px;">@Html.DisplayNameFor(model => model.CreatedAt)</th>
                <th style="width: 300px;">@Html.DisplayNameFor(model => model.UpdatedAt)</th>
                <th style="width: 400px;">Actions</th>
            </tr>

            @foreach (var item in group)
            {
                var priorityClass = item.Priority == "High" ? "badge-high" :
                                    item.Priority == "Medium" ? "badge-medium" :
                                    item.Priority == "Low" ? "badge-low" : "badge-low";
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.TaskName)</td>
                    <td style="text-align: center;"><span class="badge @priorityClass">@Html.DisplayFor(modelItem => item.Priority)</span></td>
                    <td style="text-align: center;">@Html.DisplayFor(modelItem => item.Executable)</td>
                    <td style="text-align: center;">@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                    <td style="text-align: center;">@Html.DisplayFor(modelItem => item.UpdatedAt)</td>
                    <td class="action-buttons" style="display: flex; justify-content: center; gap: 10px;">
                        @if (isAdmin)
                        {
                            @Html.ActionLink("Edit", "Edit", new { id = item.TaskId }, new { @class = "btn-action edit" })
                        }
                        @Html.ActionLink("Details", "Details", new { id = item.TaskId }, new { @class = "btn-action details" })
                        @if (isAdmin)
                        {
                            @Html.ActionLink("Delete", "Delete", new { id = item.TaskId }, new { @class = "btn-action delete" })
                        }
                        </td>
                </tr>
            }
        </table>
        <hr style="margin-top: 30px;" />
    </div>
}

