@model FinalProject.Data.Tasks

<link href="~/Content/Site.css" rel="stylesheet" />

@{
    ViewBag.Title = "Details";
}


<h2>Details</h2>

<div class="details-container">
    <h4>Tasks</h4>
    <hr class="custom-divider" />
    <dl>
        <dt>@Html.DisplayNameFor(model => model.TaskName)</dt>
        <dd>@Html.DisplayFor(model => model.TaskName)</dd>

        <dt>@Html.DisplayNameFor(model => model.Priority)</dt>
        <dd>@Html.DisplayFor(model => model.Priority)</dd>

        <dt>@Html.DisplayNameFor(model => model.Executable)</dt>
        <dd>@Html.DisplayFor(model => model.Executable)</dd>

        <dt>@Html.DisplayNameFor(model => model.CreatedAt)</dt>
        <dd>@Html.DisplayFor(model => model.CreatedAt)</dd>

        <dt>@Html.DisplayNameFor(model => model.UpdatedAt)</dt>
        <dd>@Html.DisplayFor(model => model.UpdatedAt)</dd>
    </dl>
</div>


<p class="btn btn-action edit">
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-action back" })
</p>