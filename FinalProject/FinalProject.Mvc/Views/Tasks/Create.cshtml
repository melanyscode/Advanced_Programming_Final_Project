@model FinalProject.Data.Tasks

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="card">
        <h4>Tasks</h4>
        <hr class="custom-divider" />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.TaskName, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.TaskName, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TaskName, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Priority, htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(model => model.Priority, (IEnumerable<SelectListItem>)ViewBag.PriorityOptions, "Select Priority", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Priority, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.Label("Executable", htmlAttributes: new { @class = "control-label" })
            <input type="file" id="fileInput" class="form-control" />
            @Html.HiddenFor(model => model.Executable)
            @Html.ValidationMessageFor(model => model.Executable, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-action edit" />
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-action back" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        document.getElementById("fileInput").addEventListener("change", function () {
            var fullPath = this.value;
            if (fullPath) {
                var fileName = fullPath.split('\\').pop().split('/').pop();
                var fullExecutablePath = "C:/Scripts/" + fileName;
                document.getElementById("Executable").value = fullExecutablePath;
            }
        });
    </script>
}


