    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-action delete" />
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-action back" })
        </div>
