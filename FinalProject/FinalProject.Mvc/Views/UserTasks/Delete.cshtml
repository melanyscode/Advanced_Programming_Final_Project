@model FinalProject.Data.UserTask

@{
    ViewBag.Title = "Delete";
}

<h2>Delete</h2>
<h3>Are you sure you want to delete this?</h3>

<div class="details-container">
    <h4>UserTask</h4>
    <hr class="custom-divider" />
    <dl>
        <dt>@Html.DisplayNameFor(model => model.Status)</dt>
        <dd>@Html.DisplayFor(model => model.Status)</dd>

        <dt>@Html.DisplayNameFor(model => model.Result)</dt>
        <dd>@Html.DisplayFor(model => model.Result)</dd>

        <dt>@Html.DisplayNameFor(model => model.ExecutionDate)</dt>
        <dd>@Html.DisplayFor(model => model.ExecutionDate)</dd>

        <dt>@Html.DisplayNameFor(model => model.Tasks.TaskName)</dt>
        <dd>@Html.DisplayFor(model => model.Tasks.TaskName)</dd>

        <dt>@Html.DisplayNameFor(model => model.User.Username)</dt>
        <dd>@Html.DisplayFor(model => model.User.Username)</dd>
