<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Infrastructure Monitor</title>
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

</head>


<body>
    <div class="app-container">
        <aside class="sidebar">

            <div style="text-align: center; margin-top: 20px;">
                <i class="fas fa-network-wired" style="font-size: 32px; color: #00c7c7; "></i>
                <h2>NETKEEP</h2>
            </div>


            <nav>
                <ul>
                    <li>
                        <a href="@Url.Action("Index", "Home")">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Tasks")">
                            <i class="fas fa-tasks"></i> Tasks
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Users")">
                            <i class="fas fa-users"></i> Users
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "UserTaskResults")">
                            <i class="fas fa-file-alt"></i> Logs
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Logout", "Account")">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>

                    </li>

                </ul>
            </nav>

        </aside>

        <div style="flex:1; display:flex; flex-direction: column; overflow: visible;">
            <header class="app-header">
                SYSTEM MAINTENANCE TASKS
            </header>

            <main class="content-area">
                @RenderBody()
            </main>


        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>