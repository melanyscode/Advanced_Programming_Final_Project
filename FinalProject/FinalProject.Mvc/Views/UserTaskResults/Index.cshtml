@model IEnumerable<FinalProject.Data.UserTaskResults>

@{
    ViewBag.Title = "Index";
    var groupedResults = Model
        .OrderByDescending(r => r.ExecutionDate)
        .GroupBy(r => r.UserTask.Status);
}


@foreach (var group in groupedResults)
{
    var latestLogs = group.Take(5).ToList();
    var hasMoreLogs = group.Count() > 5;

    <div class="activity-section">
        <h3 class="activity-title">@group.Key Status</h3>
        <div class="timeline" id="timeline-@group.Key.Replace(" ", "")">
            @foreach (var item in latestLogs)
            {
                var statusClass = item.UserTask.Status == "Pending" ? "mybadge-pending" :
                                  item.UserTask.Status == "Running" ? "mybadge-running" :
                                  item.UserTask.Status == "Completed" ? "mybadge-completed" :
                                  item.UserTask.Status == "Failed" ? "mybadge-failed" : "mybadge-pending";

                <div class="timeline-item">
                    <div class="timeline-content">
                        <div>
                            <div class="timeline-date">@item.ExecutionDate</div>
                            <div class="timeline-result">@item.ResultValue</div>
                        </div>
                        <div class="timeline-status">
                            <span class="mybadge @statusClass">@item.UserTask.Status</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (hasMoreLogs)
        {
            <button class="view-all-btn" data-status="@group.Key.Replace(" ", "")">View all logs</button>
        }
    </div>
}

<script>
    document.querySelectorAll(".view-all-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            const statusKey = this.getAttribute("data-status");
            const container = document.getElementById(`timeline-${statusKey}`);

            this.style.display = "none";

            @foreach (var group in groupedResults)
            {
                var skipLogs = group.Skip(5).ToList();
                var statusKey = group.Key.Replace(" ", "");

                foreach (var item in skipLogs)
                {
                    var statusClass = item.UserTask.Status == "Pending" ? "mybadge-pending" :
                                      item.UserTask.Status == "Running" ? "mybadge-running" :
                                      item.UserTask.Status == "Completed" ? "mybadge-completed" :
                                      item.UserTask.Status == "Failed" ? "mybadge-failed" : "mybadge-pending";

                    <text>
                        if (statusKey === "@statusKey") {
                            container.innerHTML += `
                                <div class="timeline-item">
                                    <div class="timeline-content">
                                        <div>
                                            <div class="timeline-date">@item.ExecutionDate</div>
                                            <div class="timeline-result">@item.ResultValue</div>
                                        </div>
                                        <div class="timeline-status">
                                            <span class="mybadge @statusClass">@item.UserTask.Status</span>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }
                    </text>
                }
            }
        });
    });
</script>
