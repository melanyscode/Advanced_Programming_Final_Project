<link href="~/Content/Site.css" rel="stylesheet" />

@{
    Layout = null;
    Page.Title = "NetKeep - Login";
}

<div class="login-container">

    <div class="login-left">
        <h1>Login</h1>
        <p class="subtitle">Access your account</p>

        <svg class="bg-circle-left" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="50" cy="50" r="50" />
        </svg>

        <svg class="bg-rect-left2" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="100" height="100" rx="20" ry="20" />
        </svg>

        <svg class="bg-triangle-left" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <polygon points="50 0, 0 100, 100 100" />
        </svg>

        <svg class="bg-hexagon-left" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <polygon points="50,0 93,25 93,75 50,100 7,75 7,25" />
        </svg>
        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "login-form" }))
        {

            <label for="username">Username</label>
            <input id="username" name="username" type="text" required autocomplete="username" placeholder="Enter username" />

            <label for="password">Password</label>
            <input id="password" name="password" type="password" required autocomplete="new-password" placeholder="Enter password" />

            <input type="submit" value="Log in" class="btn-login" />

        }
        @if (ViewBag.Error != null)
        {
            <div style="color: white;">@ViewBag.Error</div>
        }

    </div>



    <div class="login-right">
        <div class="welcome-content">
            <div class="welcome-icon">
                <i class="fa-user-plus"></i>
            </div>
            <h2>NetKeep</h2>
            <p>Secure, Reliable & Professional Infrastructure Monitoring</p>
        </div>

        <svg class="bg-shape bg-circle1" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="50" cy="50" r="50" />
        </svg>
        <svg class="bg-shape bg-rect1" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="80" height="80" />
        </svg>
        <svg class="bg-shape bg-rect2" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="80" height="80" />
        </svg>
        <svg class="bg-shape bg-triangle" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" />
    </div>



</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
